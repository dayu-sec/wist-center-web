extern mod vfm { path = "@{PATH}"; }

mod  envs {
  env default {
     ROOT= "./";
  }
}
mod main   : ver_adm {

#[auto_load(entry)]
  flow _entry : ver.use {
  }

  // 没有 `flow _set_ver | ver.syn_file`：本仓没有跟着版本走的文件。
  // 原先指向 `.github/workflows/release.yml`，但该文件里没有 `#@gxl:set(version)` 标记，
  // 退出钩子在 strict 模式下必然 `marker hit mismatch`（hits=0），让 `gx adm v_patch` 以 255 失败。
  // 版本权威就是 `version.txt` 本身（tag 与它同名），与 wist-gateway-web / 两个 stack 仓保持一致。
}
